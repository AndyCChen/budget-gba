[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.1
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://../gba/target/debug/libgba.so"
linux.release.x86_64 =   "res://../gba/target/release/libgba.so"
windows.debug.x86_64 =   "res://../gba/target/debug/gba.dll"
windows.release.x86_64 = "res://../gba/target/release/gba.dll"
macos.debug =            "res://../gba/target/debug/libgba.dylib"
macos.release =          "res://../gba/target/release/libgba.dylib"
macos.debug.arm64 =      "res://../gba/target/debug/libgba.dylib"
macos.release.arm64 =    "res://../gba/target/release/libgba.dylib"
